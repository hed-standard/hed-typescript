{
  "name": "hed-validator",
  "version": "4.1.4",
  "description": "A JavaScript validator for HED (Hierarchical Event Descriptor) strings.",
  "main": "./dist/commonjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/commonjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "github:hed-standard/hed-typescript"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "test": "jest --testPathPatterns='/tests/'",
    "testSpecs": "jest --testPathPatterns='/spec_tests/' --silent --noStackTrace",
    "type-check": "tsc --noEmit",
    "coverage": "jest --coverage",
    "prepare": "husky",
    "docs": "typedoc --options typedoc.json",
    "clear_jest_cache": "jest --clearCache"
  },
  "contributors": [
    "Alexander Jones",
    "Kay Robbins"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hed-standard/hed-typescript/issues"
  },
  "homepage": "https://github.com/hed-standard/hed-typescript",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "lodash": "^4.18.1",
    "pluralize": "^8.0.0",
    "semver": "^7.8.5",
    "unicode-name": "^1.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "@types/semver": "^7.8.0",
    "@types/unicode-name": "^1.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-jest": "^30.5.1",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "esbuild-runner": "^2.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.1",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "js-yaml": "^3.15.1"
  },
  "browser": {
    "fs": false
  },
  "files": [
    "dist/*",
    "esbuild.mjs"
  ]
}
